# Dockerfile compose-friendly — context = raiz do repo (não apps/web).
# Usado pelo docker-compose.prod.yml. O Dockerfile "original" (apps/web/Dockerfile)
# com context = apps/web/ continua válido pro GitHub Actions e ECS build (que
# fazem `cp -r apps/landing apps/web/landing` antes do docker build).
#
# Aqui o context é o repo inteiro, então conseguimos puxar apps/landing
# direto sem precisar de pre-step.

# Stage 1: build Angular
FROM node:20-alpine AS build
WORKDIR /app

# Cache layer: deps primeiro (mudam menos)
COPY apps/web/package.json apps/web/package-lock.json ./
# scripts/ precisa estar disponível antes do npm ci porque postinstall roda
# scripts/download-mediapipe-assets.js (self-host MediaPipe WASM+models).
COPY apps/web/scripts ./scripts
RUN npm ci

# CACHEBUST quebra cache aqui pra forçar rebuild quando código mudar
ARG CACHEBUST
COPY apps/web/ .

# Copia landing pra dentro do build context pra ng pegar nos assets/copy phase
COPY apps/landing ./landing

RUN npx ng build --configuration=production

# Stage 2: nginx serve
FROM nginx:alpine
COPY --from=build /app/dist/genomaflow-web/browser /usr/share/nginx/html
COPY --from=build /app/landing /usr/share/nginx/landing
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
