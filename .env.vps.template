# ============================================================================
# Template do .env pra deploy na VPS Hostinger.
# Copiar pra .env (sem extensão) na raiz do projeto NA VPS:
#   cp .env.vps.template .env
#   nano .env  # preencher TODOS os valores marcados COMO XXX
#
# .env nunca vai pro git (gitignored). Backup separado obrigatório.
# ============================================================================

# ─── Banco de dados (PostgreSQL local no Docker) ─────────────────────────────
DB_USER=genomaflow
DB_PASSWORD=XXX_GERAR_SENHA_FORTE_AQUI_32CHARS_XXX
DB_NAME=genomaflow

# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_URL setado no docker-compose como redis://redis:6379 — não tocar aqui.

# ─── JWT (mesmo valor de hoje pra não invalidar tokens existentes) ───────────
# Pegar de:  aws ssm get-parameter --name /genomaflow/prod/jwt-secret --with-decryption --query 'Parameter.Value' --output text
JWT_SECRET=XXX_MIGRAR_DO_SSM_AWS_XXX

# ─── Storage (MinIO interno) ─────────────────────────────────────────────────
# Root credentials do MinIO (admin). NÃO usar diretamente no app — criar
# credentials separadas via console pra cada bucket/uso.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=XXX_GERAR_SENHA_FORTE_AQUI_32CHARS_XXX

# Credentials que o app usa pra ler/escrever bucket. Criar via:
#   docker exec -it genomaflow-minio mc alias set local http://localhost:9000 admin <pwd>
#   docker exec -it genomaflow-minio mc admin user add local genomaflow-app <new-key> <new-secret>
#   docker exec -it genomaflow-minio mc admin policy attach local readwrite --user genomaflow-app
S3_ACCESS_KEY_ID=XXX_GERAR_NO_MINIO_CONSOLE_XXX
S3_SECRET_ACCESS_KEY=XXX_GERAR_NO_MINIO_CONSOLE_XXX
S3_BUCKET=genomaflow-uploads

# S3_ENDPOINT, S3_PUBLIC_URL, S3_FORCE_PATH_STYLE setados via docker-compose.

# ─── AWS (somente Chime SDK Meetings) ────────────────────────────────────────
# Usuário IAM dedicado com policy só pra chime:CreateMeeting etc.
# Pegar credenciais de um IAM user novo (não reusar a credencial atual do auditty-deploy).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXX_IAM_USER_GENOMAFLOW_CHIME_XXX
AWS_SECRET_ACCESS_KEY=XXX_IAM_USER_GENOMAFLOW_CHIME_XXX

# ─── Anthropic + OpenAI ──────────────────────────────────────────────────────
# Pegar via aws ssm get-parameter --name /genomaflow/prod/anthropic-api-key --with-decryption
ANTHROPIC_API_KEY=sk-ant-XXX
OPENAI_API_KEY=sk-XXX

# ─── Stripe (Live mode) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_XXX
STRIPE_WEBHOOK_SECRET=whsec_XXX
STRIPE_PRICE_SUBSCRIPTION=price_1TTWG2DDCV02NXEwRssSGnPy

# ─── Z-API (WhatsApp) ────────────────────────────────────────────────────────
ZAPI_INSTANCE_ID=XXX
ZAPI_TOKEN=XXX
ZAPI_CLIENT_TOKEN=XXX

# ─── Trello QA Agent ─────────────────────────────────────────────────────────
TRELLO_API_KEY=XXX
TRELLO_API_TOKEN=XXX
TRELLO_WEBHOOK_SECRET=XXX
TRELLO_BOARD_ID=XXX
TRELLO_QA_LIST_ID=XXX
TRELLO_IDEIAS_LIST_ID=XXX
TRELLO_ROADMAP_LIST_ID=XXX
TRELLO_TRIAGE_MODEL=claude-sonnet-4-6
TRELLO_FIX_MODEL=claude-sonnet-4-6
TRELLO_REPO_ROOT=/app/repo
WEBHOOK_CALLBACK_URL=https://app.genomaflow.com.br/api/webhooks/trello

# GitHub token pro Trello Fix Agent (push de fixes via gh CLI).
GITHUB_BOT_TOKEN=ghp_XXX

# ─── SMTP (Zoho) — substituto do SES ─────────────────────────────────────────
# Mailer (apps/api/src/mailer/index.js) detecta SMTP_HOST setado e usa SMTP
# em vez de SES. Já está implementado, só preencher.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=atendimento@genomaflow.com.br
SMTP_PASS=XXX_APP_PASSWORD_ZOHO_XXX
SMTP_FROM_EMAIL=atendimento@genomaflow.com.br

# Email "from" pra envios transacionais (verificação, reset senha, NPS).
SES_FROM_EMAIL=noreply@genomaflow.com.br

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.genomaflow.com.br

# NÃO reintroduzir NODE_TLS_REJECT_UNAUTHORIZED=0 aqui.
#
# Ele existia na era AWS por causa do CA self-signed do RDS (decisão registrada
# em docs/claude-memory/project_audit_2026_05_10_decisions.md, PR15) e veio
# copiado junto pra este template. Na VPS o Postgres é contêiner na rede
# interna do Docker e a conexão é `?sslmode=disable` — o flag não protege
# conexão de banco nenhuma. O que ele faz aqui é desligar verificação de
# certificado em TODA saída HTTPS do processo: Stripe, Anthropic, Z-API e SMTP.
# A premissa que justificava mantê-lo deixou de existir junto com o RDS.

# ─── SES Configuration Set ───────────────────────────────────────────────────
# Não usado fora da AWS (sem SES). Mailer ignora se SMTP_HOST estiver setado.
# SES_CONFIGURATION_SET=genomaflow-events
